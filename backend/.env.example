# HO backend configuration (consumed by backend/config/database.py and
# backend/api/app.py). The HO_Setup installer generates a production copy of
# these values at <install>\config\ho.env.

# --- Database ---------------------------------------------------------------
DB_SERVER=localhost
DB_DATABASE=NEXORA_PLATFORM
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_AUTH_MODE=SQL
DB_USERNAME=sa
DB_PASSWORD=password

# --- Application ------------------------------------------------------------
# Public base URL the SPA uses to reach this API (baked into /config.js).
# LEAVE EMPTY when this service also serves the SPA (UNINEX_FRONTEND_DIR): the
# SPA then calls whichever host loaded it, so a local LAN IP, a domain and a
# static IP all work at once. Set an absolute URL only for a cross-origin deploy.
UNINEX_API_URL=
# Comma-separated CORS origins — list every route the SPA is opened from when it
# is served separately (dev / a different static host), e.g.:
#   UNINEX_CORS_ORIGINS=http://192.168.10.80:8000,https://ho.example.com,http://203.0.113.10:8000
UNINEX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Or match a whole subnet / pattern instead of listing each origin:
#   UNINEX_CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+)(:\d+)?
# UNINEX_CORS_ORIGIN_REGEX=
# Absolute path to the production SPA build; when set the API also serves it.
# UNINEX_FRONTEND_DIR=C:\Program Files\UniNex\HO\frontend
# Host/port the Windows service binds uvicorn to.
UNINEX_HOST=0.0.0.0
UNINEX_PORT=8000
# Writable paths.
UNINEX_LOG_PATH=
UNINEX_UPLOAD_PATH=

# --- Legacy Order console (old OrderNMC database) -----------------------------
# The console reads/writes the legacy OrderNMC DB. It normally sits on the same
# SQL Server as NEXORA_PLATFORM, so server/user/password are inherited from the
# DB_* settings above and only the database name differs. Set these only to point
# the console at a different host. Branch-store credentials are NOT set here --
# they are read per store from OrderNMC's own dbo.Stores table.
LEGACY_DB_DATABASE=OrderNMC
# LEGACY_DB_SERVER=
# LEGACY_DB_USERNAME=
# LEGACY_DB_PASSWORD=
# LEGACY_DB_DRIVER=

# --- Time Report module (Matrix COSEC attendance database) -------------------
# Ported from the standalone COSEC attendance Flask app. This is a genuinely
# separate SQL Server instance (its own box, its own login) -- unlike
# LEGACY_DB_* above it does NOT fall back to the platform DB_* values, so all
# four must be set for the module to work. Reads Mx_DATDTrn / Mx_UserMst /
# Mx_DepartmentMst only; the module never writes to COSEC.
COSEC_DB_SERVER=192.168.1.10\SQLEXPRESS
COSEC_DB_DATABASE=COSEC
COSEC_DB_USERNAME=cosec_user
COSEC_DB_PASSWORD=password
# COSEC_DB_DRIVER=ODBC Driver 17 for SQL Server
