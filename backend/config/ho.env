# Fixed, account-independent location for Playwright's bundled browsers.
# Without this, the service (running as SYSTEM) looks under
# C:\WINDOWS\system32\config\systemprofile\AppData\Local\ms-playwright and
# finds nothing, so WhatsApp send fails with "Executable doesn't exist".
PLAYWRIGHT_BROWSERS_PATH=E:\Nexora\.ms-playwright

UNINEX_JWT_SECRET=8d630d92c46cb52d4bec8fd8fe37e36528c9260d628ee897d8fcc0e41b3ca98d
UNINEX_JWT_EXPIRE_MINUTES=720
UNINEX_SETUP_USERNAME=setupdeploy
UNINEX_SETUP_PASSWORD=NexoraSetupPull_2026!7cV4rA9mQ2
UNINEX_SETUP_JWT_EXPIRE_MINUTES=43200

UNINEX_CORS_ORIGINS=http://192.168.10.80:8443,http://122.252.246.181:8443
UNINEX_CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1|192\.168\.10\.80|122\.252\.246\.181)(:\d+)?
