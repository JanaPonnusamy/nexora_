{
  "name": "nexora-supplier-stock-client",
  "version": "0.1.74",
  "private": true,
  "description": "NexTech Supplier Stock — Intelligent Pharmaceutical Workspace desktop client",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"node scripts/wait-and-launch.mjs\"",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron .",
    "dist": "vite build && electron-builder --win --config.artifactName=\"NexTech-Supplier-Stock-Setup-${version}.${ext}\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.8",
    "ag-grid-community": "32.3.9",
    "ag-grid-react": "32.3.9",
    "electron-updater": "^6.1.9",
    "fflate": "^0.8.3",
    "react": "latest",
    "react-dom": "latest",
    "xlsx-js-style": "^1.2.0"
  },
  "build": {
    "appId": "com.nexora.desktop.stock",
    "productName": "NexTech Supplier Stock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools"
      },
      {
        "from": "../../dist/NexoraDeviceController.exe",
        "to": "controller/NexoraDeviceController.exe"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "http://192.168.10.80:8000/updates"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/assets/nextech-mediq.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": false
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "22.3.27",
    "electron-builder": "^24.13.3",
    "vite": "latest",
    "wait-on": "latest"
  }
}
