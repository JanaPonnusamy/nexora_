{
  "name": "nexora-supplier-stock-client",
  "version": "0.1.4",
  "private": true,
  "description": "Nexora supplier stock desktop client scaffold",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"node scripts/wait-and-launch.mjs\"",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron .",
    "dist": "vite build && electron-builder --win --config.artifactName=\"Nexora-Supplier-Stock-Setup-${version}.${ext}\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.8",
    "react": "latest",
    "react-dom": "latest",
    "xlsx-js-style": "^1.2.0"
  },
  "build": {
    "appId": "com.nexora.desktop.stock",
    "productName": "Nexora Supplier Stock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "22.3.27",
    "electron-builder": "^24.13.3",
    "vite": "latest",
    "wait-on": "latest"
  }
}
