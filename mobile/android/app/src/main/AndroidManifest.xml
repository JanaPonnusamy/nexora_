<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network access. INTERNET was previously declared only in the debug and
         profile manifests, which meant release builds shipped without it and
         every API call failed. It belongs here so all build types have it. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Read by connectivity_plus to drive online/offline sync transitions. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Unlock-on-open (local_auth). Not a runtime permission: it is granted at
         install and only lets the app ask BiometricPrompt to verify the user —
         it never exposes the biometric itself. MainActivity extends
         FlutterFragmentActivity for the same feature; BiometricPrompt is a
         Fragment and fails at tap time under a plain FlutterActivity. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>

    <!-- Document capture. Declared with the feature that uses them, so Play
         Console review never sees a sensitive permission the app cannot
         justify. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Picking an existing scan on Android 13+ (READ_EXTERNAL_STORAGE below
         covers 12 and earlier). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>

    <!-- A camera is not required to install: a user who only reviews and
         exports documents on a tablet without one must still be able to. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <application
        android:label="Axythic"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
