# UniNex HO configuration template (reference copy).
# The live file at config\ho.env is generated by the installer with real values.
# Edit + restart the service (sc stop UniNexHO & sc start UniNexHO) to change.

DB_SERVER=__SQL_SERVER__
DB_DATABASE=NEXORA_PLATFORM
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_AUTH_MODE=SQL
DB_USERNAME=sa
DB_PASSWORD=__PASSWORD__

UNINEX_API_URL=http://__PUBLIC_HOST__:8000
UNINEX_FRONTEND_URL=http://__PUBLIC_HOST__:8000
UNINEX_FRONTEND_DIR=__INSTALL_DIR__\frontend
UNINEX_CORS_ORIGINS=http://__PUBLIC_HOST__:8000
UNINEX_HOST=0.0.0.0
UNINEX_PORT=8000
UNINEX_LOG_PATH=__INSTALL_DIR__\logs
UNINEX_UPLOAD_PATH=__INSTALL_DIR__\uploads
